<Window x:Class="MetroCharms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        WindowStyle="None" AllowsTransparency="False" Background="Black"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="625" Height="800" FontFamily="Segoe UI" Foreground="White"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Diganti saat runtime dengan warna accent Windows -->
        <SolidColorBrush x:Key="AccentBrush" Color="#1BA1E2"/>
        <!-- ===== Metro styles ===== -->
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style x:Key="Ico" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="TileBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="Black" BorderBrush="#333333" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Jam / tanggal / cuaca -->
                <RowDefinition Height="Auto"/>   <!-- Bar navigasi -->
                <RowDefinition Height="*"/>      <!-- WebView2 -->
            </Grid.RowDefinitions>

            <!-- ===== HEADER: JAM, TANGGAL, CUACA ===== -->
            <Grid Grid.Row="0" Margin="12,16,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Jam | Cuaca -->
                    <RowDefinition Height="Auto"/>   <!-- Tanggal | Baterai -->
                </Grid.RowDefinitions>

                <!-- Baris 1: jam (kiri) | cuaca (kanan) -->
                <TextBlock x:Name="Clock" Grid.Row="0" Grid.Column="0" FontSize="54" FontFamily="Segoe UI Light"
                           Text="00:00" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="WxIco" FontFamily="Segoe UI Symbol" FontSize="26" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WxTemp" FontSize="30" FontFamily="Segoe UI Light" Text="--°"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="WxDesc" Style="{StaticResource Cap}" Text="Loading..."/>
                        <TextBlock x:Name="WxCity" Style="{StaticResource Cap}" Margin="6,0,0,0" MaxWidth="110"
                                   TextTrimming="CharacterEllipsis" Opacity="0.6"/>
                    </StackPanel>
                </StackPanel>

                <!-- Baris 2: tanggal (kiri) | baterai (kanan), satu garis -->
                <TextBlock x:Name="DateTxt" Grid.Row="1" Grid.Column="0" FontSize="16" Opacity="0.8" VerticalAlignment="Center"/>
                <StackPanel x:Name="BatLine" Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="BatIco" Style="{StaticResource Ico}" FontSize="16" Margin="0,1,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BatTxt" FontSize="14" FontFamily="Segoe UI Semibold" Opacity="0.85" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ===== BAR NAVIGASI ===== -->
            <Grid Grid.Row="1" Margin="10,0,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="WaBtn" Grid.Column="0" Style="{StaticResource TileBtn}" Background="#3A3A3A" Height="40"
                        Tag="https://web.whatsapp.com" Click="Nav_Click">
                    <TextBlock Text="WhatsApp" FontSize="13" FontFamily="Segoe UI Semibold"/>
                </Button>
                <Button x:Name="IgBtn" Grid.Column="1" Style="{StaticResource TileBtn}" Background="#3A3A3A" Height="40"
                        Tag="https://www.instagram.com" Click="Nav_Click">
                    <TextBlock Text="Instagram" FontSize="13" FontFamily="Segoe UI Semibold"/>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource TileBtn}" Background="#2B2B2B" Width="40" Height="40" Padding="0"
                        ToolTip="Reload" Click="Reload_Click">
                    <TextBlock Style="{StaticResource Ico}" Text="&#xE72C;"/>
                </Button>
                <Button x:Name="PinBtn" Grid.Column="3" Style="{StaticResource TileBtn}" Background="#2B2B2B" Width="40" Height="40" Padding="0"
                        ToolTip="Pin (jangan auto-hide)" Click="Pin_Click">
                    <TextBlock x:Name="PinIco" Style="{StaticResource Ico}" Text="&#xE718;"/>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource TileBtn}" Background="#2B2B2B" Width="40" Height="40" Padding="0"
                        ToolTip="Exit Charms Bar" Click="Exit_Click">
                    <TextBlock Style="{StaticResource Ico}" Text="&#xE711;"/>
                </Button>
            </Grid>

            <!-- ===== WEBVIEW2 =====
                 Source SENGAJA tidak diisi di XAML: environment (folder data persisten)
                 dibuat di code-behind, lalu navigasi dilakukan setelah inisialisasi. -->
            <Border Grid.Row="2" Background="Black" Margin="12,0,12,12">
                <Grid>
                    <wv2:WebView2 x:Name="WebWa"/>
                    <wv2:WebView2 x:Name="WebIg" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
